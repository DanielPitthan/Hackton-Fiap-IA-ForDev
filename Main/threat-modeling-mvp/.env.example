# ─── Application ────────────────────────────────────────────────────────────
APP_NAME=threat-modeling-mvp
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ─── API Keys (Vision Models) ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# Vision model to use: openai | anthropic | google | local
VISION_MODEL_PROVIDER=anthropic
VISION_MODEL_NAME=claude-3-5-sonnet-20241022

# ─── Database ─────────────────────────────────────────────────────────────
# SQLite (default for development)
DATABASE_URL=sqlite+aiosqlite:///./data/threat_modeling.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/threat_modeling

# ─── Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/raw
PROCESSED_DIR=./data/processed
REPORTS_DIR=./reports
MAX_UPLOAD_SIZE_MB=20

# ─── CORS ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ─── Security ─────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
API_KEY_HEADER=X-API-Key
